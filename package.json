{
  "name": "markdown-reader",
  "productName": "Markdown Reader",
  "version": "1.1.8",
  "description": "A clean, read-only markdown viewer for macOS.",
  "main": "dist/main.cjs",
  "private": true,
  "scripts": {
    "build:main": "node build.mjs",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "start": "pnpm run build:main && node dev.mjs",
    "dist:mac": "NODE_ENV=production pnpm run build && xattr -cr node_modules/electron && electron-builder --mac --config electron-builder.yml",
    "typecheck": "tsc --noEmit"
  },
  "author": {
    "name": "Sean Rice",
    "email": "sean@untasker.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "font-list": "^2.1.0",
    "posthog-node": "^5.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-shiki": "^0.11.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0"
  }
}
