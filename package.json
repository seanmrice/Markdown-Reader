{
  "name": "markdown-reader",
  "productName": "Markdown Reader",
  "version": "1.0.0",
  "description": "A clean, read-only markdown viewer for macOS.",
  "main": "dist/main.cjs",
  "private": true,
  "scripts": {
    "build:main": "node build.mjs",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "start": "pnpm run build:main && node dev.mjs",
    "dist:mac": "pnpm run build && electron-builder --mac --config electron-builder.yml",
    "typecheck": "tsc --noEmit"
  },
  "author": {
    "name": "Sean Rice",
    "email": "sean.m.rice@gmail.com"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.7",
    "typescript": "~5.8.3",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "font-list": "^2.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-shiki": "^0.9.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2"
  }
}
